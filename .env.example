# 火山方舟 Ark（文字 + 生图）配置模板（非机密，可提交）
# 说明：Vite 仅加载 .env / .env.local / .env.[mode] / .env.[mode].local，不会加载本文件。
# 密钥请填到同目录 .env.local（已被 .gitignore 忽略），不要填在这里。

# ── 文生本：火山方舟 Ark（OpenAI 兼容协议）──
VITE_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VITE_TEXT_MODEL=doubao-seed-2-0-mini-260215

# ── 生图：火山方舟 Ark（OpenAI 兼容 images 协议）──
# 若你用非北京区或专属 endpoint，改这里即可
VITE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VITE_IMAGE_MODEL=doubao-seedream-4-5-251128

# ── Vercel 部署（可选）：共享访问口令，防公网代理被陌生人刷掉额度 ──
# 在 Vercel 项目环境变量里设 DEMO_ACCESS_TOKEN（服务端校验）；
# 同时在构建环境变量里设 VITE_ACCESS_TOKEN（会打进前端 bundle，仅供作防滥用门槛）：
# DEMO_ACCESS_TOKEN=
# VITE_ACCESS_TOKEN=

# ── 密钥（推荐：Mode A，服务端注入，不进浏览器）──
# 复制本文件为同目录 .env.local，把下面两行取消注释并分别填上 key：
# ARK_TEXT_API_KEY=火山方舟Ark的key（可与图片Key相同）
# ARK_IMAGE_API_KEY=sk-火山方舟Ark的key
#
# Mode B 不需要在 .env 中配置 Key；每位用户在 Connections 面板填写自己的 Ark Key。
